{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://candy.example/sdwan-client/contracts/agent-capabilities-v1.schema.json",
  "title": "SD-WAN Client AgentCapabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "agent_version", "platform", "methods", "features"],
  "properties": {
    "api_version": { "const": 1 },
    "agent_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "platform": { "enum": ["windows", "macos", "android"] },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
